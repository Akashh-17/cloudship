PORT=3000
NODE_ENV=development
AWS_REGION=ap-south-1
SQS_QUEUE_URL=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=cloudship-deployments
USERS_TABLE_NAME=cloudship-users
SESSION_TABLE_NAME=cloudship-sessions

# ── 1. AWS IAM Credentials (Optional if configured via `aws configure`) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ── 2. Security & CORS (Required for Frontend to communicate with Backend) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# ── 3. Worker Concurrency (How many builds run at the same time) ──
WORKER_CONCURRENCY=3
# ── 4. API Key Gate (Optional in local development — leave blank for open dev) ──
API_KEY=
# ── 5. Rate Limiting (Default: 10 deployment requests per 15 minutes) ──
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15
# ── 6. GitHub Webhook Secret (For Push-to-Deploy) ──
GITHUB_WEBHOOK_SECRET=
# ── 7. GitHub OAuth (Sign in with GitHub) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=replace_with_64_char_random_string
FRONTEND_URL=http://localhost:5173
GITHUB_CALLBACK_URL=
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY=false
